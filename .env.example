# Supabase project Connect dialog: Project URL and publishable key.
# The publishable key is safe in the browser because database RLS is enabled.
# NEVER paste the service_role key, secret API key, or database password here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
